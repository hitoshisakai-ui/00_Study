    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
