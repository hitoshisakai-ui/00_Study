{
  "name": "memopad-hands-on",
  "version": "0.1.0",
  "private": true,
  "description": "QA exercise memo pad application with React and Express.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
